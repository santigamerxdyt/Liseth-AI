# CONFIGURACIÓN GENERAL
PORT=3000
JARVIS_ACCESS_PIN=1234
MASTER_ENCRYPTION_KEY=jarvis-secret-key-32-chars-change-me

# CEREBROS IA (LLMs)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# GOOGLE WORKSPACE OAUTH 2.0 (Gratuito)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth2callback

# CANALES DE NOTIFICACIÓN
# Opción 1: WhatsApp Business Cloud API (Meta Oficial)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=jarvis_webhook_verify_token
META_WA_RECIPIENT_PHONE=

# Opción 2: Telegram Bot (100% Gratuito y sin restricciones)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SÍNTESIS DE VOZ OPCIONAL
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# MODELOS Y CONTROL DE COSTES (Fase 4)
# Modelos de Gemini: gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
# Modelos de Claude: claude-3-5-sonnet-20241022 | claude-3-5-haiku-20241022
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Límite de tokens diarios para detener consultas preventivamente y umbral de alerta (%)
DAILY_TOKEN_LIMIT=100000
ALERT_THRESHOLD_PCT=80
